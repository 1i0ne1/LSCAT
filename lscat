# =============================================================================
# Main Argument Parsing
# =============================================================================
if [[ $# -eq 1 ]] && ([[ "$1" == "-i" ]] || [[ "$1" == "--install" ]]); then
install_lscat
fi

# Only real option names stop a value scan: value-taking flags accept a
# next token that is not a known option, so values may start with "-"
# themselves ("-de ---", the documented default delimiter, used to be
# rejected as an unknown option).
is_known_option() {
case "$1" in
-h|--help|-v|--version|-d|--dir|-f|--file|-a|--all|-D|--destination|-de|--delimiter|-c|--compress|-C|--compress-hard|-l|--line-numbers|-H|--header-type|-sd|--skip-dir|-sf|--skip-file|-i|--install|--) return 0 ;;
*) return 1 ;;
esac
}

ALL_ARGS=("$@")
i=0
while [[ $i -lt ${#ALL_ARGS[@]} ]]; do
arg="${ALL_ARGS[$i]}"
case "$arg" in
-h|--help) print_help; exit 0 ;;
-v|--version) print_version; exit 0 ;;
-d|--dir)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; do
DIRECTORIES+=("${ALL_ARGS[$i]}"); ((i++))
done; ((i--)) ;;
-f|--file)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; do
FILES+=("${ALL_ARGS[$i]}"); ((i++))
done; ((i--)) ;;
-sd|--skip-dir)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; do
SKIP_DIRS+=("${ALL_ARGS[$i]}"); ((i++))
done; ((i--)) ;;
-sf|--skip-file)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; do
SKIP_FILES+=("${ALL_ARGS[$i]}"); ((i++))
done; ((i--)) ;;
-a|--all) INCLUDE_HIDDEN=true ;;
-D|--destination)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; do
OUTPUT_FILES+=("${ALL_ARGS[$i]}"); ((i++))
done; ((i--)) ;;
-de|--delimiter)
((i++))
if [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; then
DELIMITER="${ALL_ARGS[$i]}"
else
print_error "Delimiter requires a value"; exit 1
fi ;;
-c|--compress) COMPRESS=true ;;
-C|--compress-hard) COMPRESS_HARD=true; COMPRESS=true ;;
-l|--line-numbers) SHOW_LINE_NUMBERS=true ;;
-H|--header-type)
((i++))
if [[ $i -lt ${#ALL_ARGS[@]} ]] && ! is_known_option "${ALL_ARGS[$i]}"; then
HEADER_TYPE="${ALL_ARGS[$i]}"
case "$HEADER_TYPE" in
"tree"|"ls"|"ls-R"|"none") ;;
*) print_error "Invalid header type: $HEADER_TYPE. Use tree, ls, ls-R, or none"; exit 1 ;;
esac
else
print_error "Header type requires a value: tree, ls, ls-R, or none"; exit 1
fi ;;
-i|--install) print_error "Install option (-i/--install) cannot be combined with other options"; exit 1 ;;
--)
((i++))
while [[ $i -lt ${#ALL_ARGS[@]} ]]; do FILES+=("${ALL_ARGS[$i]}"); ((i++)); done
break ;;
-*) print_error "Unknown option: $arg"; exit 1 ;;
*)
print_error "Positional arguments are not supported. Use -d for directories or -f for files."
print_error "Example: lscat -d . or lscat -f *.md"
print_error "Found argument: $arg"
exit 1 ;;
esac
((i++))
done

# Default to current directory if nothing specified
if [[ ${#DIRECTORIES[@]} -eq 0 ]] && [[ ${#FILES[@]} -eq 0 ]]; then
DIRECTORIES=(".")
POSITIONAL_DIRECTORIES=true
fi

# "-d ." means the current directory only (non-recursive tree, top-level files).
# The flag used to exist but was never set, so "." silently recursed everything.
for dir in "${DIRECTORIES[@]}"; do
if [[ "$dir" == "." ]]; then
NON_RECURSIVE=true
fi
done

# Expand patterns for directories and files
if [[ ${#DIRECTORIES[@]} -gt 0 ]]; then
temp_dirs=()
for dir in "${DIRECTORIES[@]}"; do
while IFS= read -r expanded_item; do
[[ -n "$expanded_item" ]] && temp_dirs+=("$expanded_item")
done < <(expand_patterns "$dir")
done
DIRECTORIES=("${temp_dirs[@]}")
fi

if [[ ${#FILES[@]} -gt 0 ]]; then
temp_files=()
for file in "${FILES[@]}"; do
while IFS= read -r expanded_item; do
[[ -n "$expanded_item" ]] && temp_files+=("$expanded_item")
done < <(expand_file_patterns "$file")
done
FILES=("${temp_files[@]}")
fi

# Per-value expansion dedups only inside one pattern call, so "dir" and
# "./dir" (or "*.md" and "x.md" from separate values) can still arrive as
# distinct entries through distinct expand_patterns/expand_file_patterns
# calls. One global collapse makes every real path process exactly once.
collapse_forms() {
local -A seen=()
local item key
local out=()
for item in "$@"; do
[[ -n "$item" ]] || continue
key="${item#./}"
key="${key%/}"
[[ -n "${seen[$key]:-}" ]] && continue
seen[$key]=1
out+=("$item")
done
if [[ ${#out[@]} -gt 0 ]]; then printf '%s\n' "${out[@]}"; fi
}
if [[ ${#DIRECTORIES[@]} -gt 0 ]]; then
mapfile -t DIRECTORIES < <(collapse_forms "${DIRECTORIES[@]}")
fi

# A root nested inside another root repeats its whole subtree: "-d *"
# expands every descendant directory, so "docs" and "docs/deep" (and
# "docs/deep/..." etc.) were each processed as a separate recursive root
# and all their files were concatenated once per level. Keep only the
# top-most roots; a recursive walk of a parent always covers its subdirs.
prune_contained_dirs() {
local -a keep=()
local a b ka kb contained
for a in "$@"; do
ka="${a#./}"; ka="${ka%/}"
[[ -z "$ka" ]] && ka="."
contained=false
for b in "$@"; do
[[ "$a" == "$b" ]] && continue
kb="${b#./}"; kb="${kb%/}"
[[ -z "$kb" ]] && kb="."
# "." is an ancestor of everything; contained paths are the literal subtree.
if [[ "$kb" == "." ]] || [[ "$ka" == "$kb"/* ]]; then
contained=true
break
fi
done
[[ "$contained" == true ]] || keep+=("$a")
done
for a in "${keep[@]}"; do
printf '%s\n' "$a"
done
}

if [[ ${#DIRECTORIES[@]} -gt 1 ]]; then
mapfile -t DIRECTORIES < <(prune_contained_dirs "${DIRECTORIES[@]}")
fi
if [[ ${#FILES[@]} -gt 0 ]]; then
mapfile -t FILES < <(collapse_forms "${FILES[@]}")
fi

is_output_file() {
# true when $1 is one of the -D destinations (never extract a destination
# into itself: "-d . -D out.txt" would otherwise read its own half-written
# content).
local probe="${1#./}"
for out_file in "${OUTPUT_FILES[@]}"; do
[[ "$probe" == "${out_file#./}" ]] && return 0
done
return 1
}

# Drop any destination that made it into the request lists.
for out_file in "${OUTPUT_FILES[@]}"; do
out_norm="${out_file#./}"
keep_dirs=()
for dir in "${DIRECTORIES[@]}"; do
dir_norm="${dir#./}"
[[ "$dir_norm" == "$out_norm" ]] || keep_dirs+=("$dir")
done
DIRECTORIES=("${keep_dirs[@]}")
keep_files=()
for file in "${FILES[@]}"; do
file_norm="${file#./}"
[[ "$file_norm" == "$out_norm" ]] || keep_files+=("$file")
done
FILES=("${keep_files[@]}")
done

# Validate inputs
HAD_ERRORS=0
VALID_DIRECTORIES=()
VALID_FILES=()
for dir in "${DIRECTORIES[@]}"; do
if [[ -d "$dir" ]]; then
VALID_DIRECTORIES+=("$dir")
elif [[ -f "$dir" ]]; then
# An unquoted "lscat -d *" hands the shell's expansion to us, files and
# dirs mixed: process the files instead of rejecting them. This removes
# the need to quote globs just to keep -d quiet.
VALID_FILES+=("$dir")
else
print_error "Directory not found: $dir"
HAD_ERRORS=1
fi
done

for file in "${FILES[@]}"; do
if [[ -f "$file" ]]; then
VALID_FILES+=("$file")
elif [[ -d "$file" ]]; then
# Directories reaching validation (e.g. via --) are listed like -f dirs,
# not rejected: one consistent, quote-free behaviour.
local hidden_files=()
local dir_item
if [[ "$INCLUDE_HIDDEN" == true ]]; then
while IFS= read -r -d $'\0' dir_item; do
[[ -f "$dir_item" ]] && hidden_files+=("$dir_item")
done < <(find "$file" -maxdepth 1 -mindepth 1 -type f -print0 2>/dev/null)
else
while IFS= read -r -d $'\0' dir_item; do
[[ -f "$dir_item" ]] && hidden_files+=("$dir_item")
done < <(find "$file" -maxdepth 1 -mindepth 1 -type f -not -name '.*' -print0 2>/dev/null)
fi
VALID_FILES+=("${hidden_files[@]}")
else
print_warning "File not found: $file (skipping)"
fi
done

# Exactly the same path can reach the validated list twice ("-f root.md
# -d root.md": the demotion adds it, -f adds it again) and would be
# concatenated twice. Collapse canonical duplicates here. A file that
# merely sits inside another listed directory is kept: re-including a
# -sf-skipped file with -f is a legitimate request.
_final_files=()
declare -A _seen_final=()
for file in "${VALID_FILES[@]}"; do
_key="./${file#./}"
[[ -n "${_seen_final[$_key]:-}" ]] && continue
_seen_final[$_key]=1
_final_files+=("$file")
done
VALID_FILES=("${_final_files[@]}")

# Dash-leading paths ("-n flagfile.txt", "-x.txt", ...) given via -f/-d/--:
# external helpers (basename, dirname, cat, iconv, ...) would otherwise eat
# them as option flags. Prefix "./" so every filename is unambiguous.
_dash_norm=()
for file in "${VALID_FILES[@]}"; do
[[ "$file" == -* ]] && file="./$file"
_dash_norm+=("$file")
done
VALID_FILES=("${_dash_norm[@]}")

# Stop on hard input errors so pipelines trust the exit code.
if [[ $HAD_ERRORS -ne 0 ]]; then
exit 1
fi

# Execute: write to file or stdout
if [[ ${#OUTPUT_FILES[@]} -gt 0 ]]; then
WRITING_TO_FILE=true
for output_file in "${OUTPUT_FILES[@]}"; do
print_info "Output will be saved to: $output_file"
# Fail loudly (single destination, non-zero exit) instead of "writing"
# a phantom file and then claiming "Output saved".
if ! ( > "$output_file" ) 2>/dev/null; then
print_error "Cannot create or write to output file: $output_file"
exit 1
fi
for dir in "${VALID_DIRECTORIES[@]}"; do
if [[ "$POSITIONAL_DIRECTORIES" == true ]] && [[ "$dir" == "." ]]; then
process_directory "$dir" true >> "$output_file"
else
process_directory "$dir" false >> "$output_file"
fi
done
for file in "${VALID_FILES[@]}"; do
process_single_file "$file" >> "$output_file"
done
done
print_info "Output saved to specified file(s)"
else
for dir in "${VALID_DIRECTORIES[@]}"; do
if [[ "$POSITIONAL_DIRECTORIES" == true ]] && [[ "$dir" == "." ]]; then
process_directory "$dir" true
else
process_directory "$dir" false
fi
done
for file in "${VALID_FILES[@]}"; do
process_single_file "$file"
done
fi