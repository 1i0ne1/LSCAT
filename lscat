# Installation function
install_lscat() {
echo "Installing lscat..."
echo "====================="
if [[ -f "$0" ]]; then
SCRIPT_PATH="$0"
else
SCRIPT_PATH="./$(basename "$0")"
fi
if [[ ! -f "$SCRIPT_PATH" ]]; then
print_error "Cannot find lscat script to install"
exit 1
fi
chmod +x "$SCRIPT_PATH" 2>/dev/null || true
echo ""
echo "Select installation method:"
echo "1) Current user only (~/.local/bin) - Recommended"
echo "2) System-wide (/usr/local/bin) - Requires sudo"
echo "3) System-wide (/usr/bin) - Requires sudo"
echo "4) Custom location with symlink"
echo "5) Cancel installation"
echo ""
read -p "Enter choice [1-5]: " choice
case $choice in
1)
mkdir -p ~/.local/bin
if cp "$SCRIPT_PATH" ~/.local/bin/lscat; then
chmod +x ~/.local/bin/lscat
echo "Installed to ~/.local/bin/lscat"
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
echo "Adding ~/.local/bin to PATH..."
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc 2>/dev/null || true
source ~/.bashrc 2>/dev/null || true
fi
else
print_error "Failed to copy to ~/.local/bin/"
exit 1
fi
;;
2)
if sudo cp "$SCRIPT_PATH" /usr/local/bin/lscat; then
sudo chmod +x /usr/local/bin/lscat
echo "Installed to /usr/local/bin/lscat"
else
print_error "Failed to install to /usr/local/bin"
exit 1
fi
;;
3)
if sudo cp "$SCRIPT_PATH" /usr/bin/lscat; then
sudo chmod +x /usr/bin/lscat
echo "Installed to /usr/bin/lscat"
else
print_error "Failed to install to /usr/bin"
exit 1
fi
;;
4)
read -p "Enter installation directory (e.g., /opt/lscat): " install_dir
if [[ -z "$install_dir" ]]; then
print_error "No directory specified"
exit 1
fi
mkdir -p "$install_dir" 2>/dev/null || sudo mkdir -p "$install_dir"
if cp "$SCRIPT_PATH" "$install_dir/lscat"; then
chmod +x "$install_dir/lscat"
read -p "Create symlink in which directory? (e.g., /usr/local/bin): " symlink_dir
if [[ -n "$symlink_dir" ]]; then
sudo ln -sf "$install_dir/lscat" "$symlink_dir/lscat" 2>/dev/null || \
ln -sf "$install_dir/lscat" "$symlink_dir/lscat"
echo "Installed to $install_dir/lscat with symlink in $symlink_dir"
else
echo "Installed to $install_dir/lscat (no symlink created)"
fi
else
print_error "Failed to install to $install_dir"
exit 1
fi
;;
5)
echo "Installation cancelled."
exit 0
;;
*)
print_error "Invalid choice!"
exit 1
;;
esac
echo ""
echo "Verifying installation..."
if command -v lscat &> /dev/null; then
echo -e "\033[32m✓ lscat installed successfully!\033[0m"
echo "Run 'lscat --help' to see usage"
else
echo -e "\033[31m✗ Installation completed but lscat not found in PATH\033[0m"
echo "You may need to log out and back in, or run: source ~/.bashrc"
fi
exit 0
}

# Enhanced pattern expansion function (DIRECTORIES ONLY - recursive)
expand_patterns() {
local items=("$@")
local expanded_items=()
for item in "${items[@]}"; do
if [[ "$item" == "*" ]]; then
if [[ "$INCLUDE_HIDDEN" == true ]]; then
while IFS= read -r -d $'\0' found_item; do
if [[ -d "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -mindepth 1 -type d -print0 2>/dev/null)
else
while IFS= read -r -d $'\0' found_item; do
if [[ -d "$found_item" ]] && [[ ! "$found_item" =~ /\. ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -mindepth 1 -type d -not -name '.*' -print0 2>/dev/null)
fi
# "*" means the whole tree: also add "." so top-level files are processed
# too (without this, files outside every subdirectory silently vanished
# from -d "*" output — incl. a root README or package config).
expanded_items+=(".")
elif [[ "$item" == "." ]] && [[ "$POSITIONAL_DIRECTORIES" == false ]]; then
expanded_items+=(".")
elif [[ "$item" == ".*" ]]; then
while IFS= read -r -d $'\0' found_item; do
if [[ -d "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -mindepth 1 -type d -name '.*' -print0 2>/dev/null)
elif [[ "$item" == *"*"* ]] || [[ "$item" == *"?"* ]] || [[ "$item" == *"["* ]]; then
if [[ -d "$item" ]]; then
expanded_items+=("$item")
else
shopt -s nullglob
local found_items=()
if [[ "$item" != */* ]] && [[ "$item" != ./* ]]; then
for found_item in ./$item; do
if [[ -d "$found_item" ]]; then
found_items+=("$found_item")
fi
done
fi
for found_item in $item; do
if [[ -d "$found_item" ]]; then
found_items+=("$found_item")
fi
done
shopt -u nullglob
if [[ ${#found_items[@]} -eq 0 ]]; then
local pattern_name=$(basename "$item")
local pattern_dir=$(dirname "$item")
[[ "$pattern_dir" == "." ]] && pattern_dir="."
if [[ "$pattern_dir" == "." ]] || [[ -d "$pattern_dir" ]]; then
# directory part is the cwd or a real directory: search there
while IFS= read -r -d $'\0' found_item; do
if [[ -d "$found_item" ]]; then
found_items+=("$found_item")
fi
done < <(find "$pattern_dir" -type d -name "$pattern_name" -print0 2>/dev/null)
else
# real directory, so anchor the search at the tree root instead of
# silently returning nothing. Hidden results only count under -a:
# paths containing a hidden component ("/.foo") are excluded.
local hidden_args=()
[[ "$INCLUDE_HIDDEN" == false ]] && hidden_args=(-not -name '.*')
while IFS= read -r -d $'\0' found_item; do
if [[ -d "$found_item" ]]; then
if [[ "$INCLUDE_HIDDEN" == true ]] || [[ ! "$found_item" =~ /\. ]]; then
found_items+=("$found_item")
fi
fi
done < <(find . -mindepth 2 -type d -name "$pattern_name" "${hidden_args[@]}" -print0 2>/dev/null)
if [[ ${#found_items[@]} -eq 0 ]]; then
print_warning "No directory matches pattern: $item"
fi
fi
fi
for found_item in "${found_items[@]}"; do
expanded_items+=("$found_item")
done
fi
else
# Keep non-glob items in the stream even when they do not exist:
# the validation pass is the single authority that warns or errors
# on them (reporting from inside this subshell would vanish with it,
# and "-d no/such/dir" must still exit non-zero for pipelines).
expanded_items+=("$item")
fi
done
# Dedup via associative array keyed on the ./-stripped path: substring
# matching (the old "${unique_items[@]}" regex) treated "dir" as a duplicate
# of "test dir", and "./x" vs "x" forms of the same directory both survived,
# getting processed twice.
local -A seen_items=()
local unique_items=()
local dedup_key
for item in "${expanded_items[@]}"; do
[[ -n "$item" ]] || continue
dedup_key="${item#./}"
dedup_key="${dedup_key%/}"
[[ -n "${seen_items[$dedup_key]:-}" ]] && continue
seen_items[$dedup_key]=1
unique_items+=("$item")
done
for item in "${unique_items[@]}"; do
printf '%s\n' "$item"
done
}
# Enhanced file pattern expansion function (FILES ONLY - non-recursive)
expand_file_patterns() {
local items=("$@")
local expanded_items=()
for item in "${items[@]}"; do
if [[ "$item" == "*" ]]; then
if [[ "$INCLUDE_HIDDEN" == true ]]; then
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -maxdepth 1 -mindepth 1 -type f -print0 2>/dev/null)
else
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -maxdepth 1 -mindepth 1 -type f -not -name '.*' -print0 2>/dev/null)
fi
elif [[ "$item" == ".*" ]]; then
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find . -maxdepth 1 -mindepth 1 -type f -name '.*' -print0 2>/dev/null)
elif [[ -d "$item" ]]; then
# "-f" received a directory (typical with an unquoted "lscat -f *",
# where the shell already expanded the glob into files AND dirs):
# list its immediate files, consistent with -f's non-recursive contract.
if [[ "$INCLUDE_HIDDEN" == true ]]; then
while IFS= read -r -d $'\0' found_item; do
[[ -f "$found_item" ]] && expanded_items+=("$found_item")
done < <(find "$item" -maxdepth 1 -mindepth 1 -type f -print0 2>/dev/null)
else
while IFS= read -r -d $'\0' found_item; do
[[ -f "$found_item" ]] && expanded_items+=("$found_item")
done < <(find "$item" -maxdepth 1 -mindepth 1 -type f -not -name '.*' -print0 2>/dev/null)
fi
elif [[ "$item" == *"*"* ]] || [[ "$item" == *"?"* ]] || [[ "$item" == *"["* ]]; then
local pattern_name=$(basename "$item")
local pattern_dir=$(dirname "$item")
[[ "$pattern_dir" == "." ]] && pattern_dir="."
if [[ -d "$pattern_dir" ]] || [[ "$pattern_dir" == "." ]]; then
if [[ "$INCLUDE_HIDDEN" == true ]]; then
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]]; then
expanded_items+=("$found_item")
fi
done < <(find "$pattern_dir" -maxdepth 1 -type f -name "$pattern_name" -print0 2>/dev/null)
else
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]] && [[ ! "$(basename "$found_item")" == .* ]]; then
expanded_items+=("$found_item")
fi
done < <(find "$pattern_dir" -maxdepth 1 -type f -name "$pattern_name" -not -name '.*' -print0 2>/dev/null)
fi
else
# Pattern like "src/*/x.js" where the dirname part is not a real
# directory: match the basename from the tree root at any depth
# instead of silently returning nothing. Hidden results only count
# under -a: paths containing a hidden component ("/.foo") are excluded
# (a plain-basename filter alone leaked files inside hidden dirs).
local hidden_args=()
[[ "$INCLUDE_HIDDEN" == false ]] && hidden_args=(-not -name '.*')
while IFS= read -r -d $'\0' found_item; do
if [[ -f "$found_item" ]]; then
if [[ "$INCLUDE_HIDDEN" == true ]] || [[ ! "$found_item" =~ /\. ]]; then
expanded_items+=("$found_item")
fi
fi
done < <(find . -mindepth 2 -type f -name "$pattern_name" "${hidden_args[@]}" -print0 2>/dev/null)
if [[ ${#expanded_items[@]} -eq 0 ]]; then
print_warning "No file matches pattern: $item"
fi
fi
else
# Same as expand_patterns: leave the item in the stream; the
# validation pass prints "File not found" exactly once.
expanded_items+=("$item")
fi
done
# Dedup via associative array on the ./-stripped path (space-safe; "./x"
# and "x" collapse to one entry so a file cannot be processed twice).
local -A seen_items=()
local unique_items=()
local dedup_key
for item in "${expanded_items[@]}"; do
[[ -n "$item" ]] || continue
dedup_key="${item#./}"
dedup_key="${dedup_key%/}"
[[ -n "${seen_items[$dedup_key]:-}" ]] && continue
seen_items[$dedup_key]=1
unique_items+=("$item")
done
for item in "${unique_items[@]}"; do
printf '%s\n' "$item"
done
}

# =============================================================================
# KEY FIX: Build find arguments with -prune for skipped directories
# -mindepth 1 is always applied: find otherwise reports the starting point
# itself, which once made the tree walk recurse into "./" forever.
# Arguments are returned through the global FIND_ARGS array (never eval'd),
# so names containing spaces, quotes, backslashes or '$' stay safe.
# =============================================================================
FIND_ARGS=()

build_find_cmd() {
local base_dir="$1"
local find_type="${2-f}"   # empty string means: no -type filter (files and dirs)
local maxdepth="${3-}"
local include_hidden="${4-false}"
local is_hidden_parent="${5-false}"

FIND_ARGS=(find "$base_dir")
# maxdepth arrives as a string like "-maxdepth 1": word-split it into argv.
[[ -n "$maxdepth" ]] && FIND_ARGS+=($maxdepth)
FIND_ARGS+=(-mindepth 1)

local -a prune_expr=()

for pattern in "${SKIP_DIRS[@]}"; do
    pattern="${pattern%/}"
    [[ -z "$pattern" ]] && continue
    local clean_pattern="${pattern#./}"

    if [[ ${#prune_expr[@]} -gt 0 ]]; then
        prune_expr+=(-o)
    fi

    if [[ "$pattern" == /* ]]; then
        prune_expr+=(-path "$pattern")
    elif [[ "$clean_pattern" == */* ]]; then
        prune_expr+=(-path "*/${clean_pattern}")
    else
        prune_expr+=(-name "$clean_pattern")
    fi
done

if [[ "$include_hidden" == false ]] && [[ "$is_hidden_parent" == false ]]; then
    if [[ ${#prune_expr[@]} -gt 0 ]]; then
        prune_expr+=(-o)
    fi
    prune_expr+=(-name ".*")
fi

if [[ ${#prune_expr[@]} -gt 0 ]]; then
    # Array form needs no shell escapes: pass "(" ")" verbatim as arguments.
    FIND_ARGS+=("(" "${prune_expr[@]}" ")" -prune -o)
    if [[ -n "$find_type" ]]; then
        FIND_ARGS+=(-type "$find_type")
    fi
    FIND_ARGS+=(-print)
else
    if [[ -n "$find_type" ]]; then
        FIND_ARGS+=(-type "$find_type")
    fi
    FIND_ARGS+=(-print)
fi
}

should_skip_dir() {
local item="$1"
local item_name=$(basename "$item")
# Normalize paths for comparison
local clean_item="${item#./}"
clean_item="${clean_item%/}"

for pattern in "${SKIP_DIRS[@]}"; do
pattern="${pattern%/}"
[[ -z "$pattern" ]] && continue
local clean_pattern="${pattern#./}"
clean_pattern="${clean_pattern%/}"

# Direct match
if [[ "$clean_item" == "$clean_pattern" ]] || [[ "$item_name" == "$pattern" ]]; then
return 0
fi

# Glob pattern matching
if [[ "$pattern" == *"*"* ]] || [[ "$pattern" == *"?"* ]] || [[ "$pattern" == *"["* ]]; then
case "$item" in $pattern) return 0 ;; esac
case "$item_name" in $pattern) return 0 ;; esac
fi

# Path prefix match (item is inside skipped dir)
if [[ "$clean_item" == "$clean_pattern"/* ]]; then
return 0
fi

# Check each parent directory
local temp_path="$clean_item"
while [[ "$temp_path" != "." ]] && [[ "$temp_path" != "" ]]; do
local current_dir="$(basename "$temp_path")"
if [[ "$current_dir" == "$clean_pattern" ]] || [[ "$current_dir" == "$pattern" ]]; then
return 0
fi
if [[ "$pattern" == *"*"* ]]; then
case "$current_dir" in $pattern) return 0 ;; esac
fi
temp_path="$(dirname "$temp_path")"
[[ "$temp_path" == "/" ]] && break
done
done
return 1
}

should_skip_file() {
local item="$1"
local item_name=$(basename "$item")
local clean_item="${item#./}"

# First check SKIP_FILES patterns
for pattern in "${SKIP_FILES[@]}"; do
pattern="${pattern%/}"
[[ -z "$pattern" ]] && continue
local clean_pattern="${pattern#./}"

if [[ "$clean_item" == "$clean_pattern" ]] || [[ "$item_name" == "$pattern" ]]; then
return 0
fi
if [[ "$pattern" == *"*"* ]] || [[ "$pattern" == *"?"* ]] || [[ "$pattern" == *"["* ]]; then
case "$item" in $pattern) return 0 ;; esac
case "$item_name" in $pattern) return 0 ;; esac
fi
if [[ "$clean_item" == "$clean_pattern"/* ]]; then
return 0
fi
done

# Also check SKIP_DIRS for files inside skipped directories
for pattern in "${SKIP_DIRS[@]}"; do
pattern="${pattern%/}"
[[ -z "$pattern" ]] && continue
local clean_pattern="${pattern#./}"

if [[ "$clean_item" == "$clean_pattern"/* ]] || [[ "$clean_item" == "$clean_pattern" ]]; then
return 0
fi

local temp_path="$(dirname "$clean_item")"
while [[ "$temp_path" != "." ]] && [[ "$temp_path" != "" ]] && [[ "$temp_path" != "/" ]]; do
local current_dir="$(basename "$temp_path")"
if [[ "$current_dir" == "$clean_pattern" ]] || [[ "$current_dir" == "$pattern" ]]; then
return 0
fi
if [[ "$pattern" == *"*"* ]]; then
case "$current_dir" in $pattern) return 0 ;; esac
fi
temp_path="$(dirname "$temp_path")"
[[ "$temp_path" == "/" ]] && break
done
done

return 1
}

should_skip() {
local item="$1"
if [[ -d "$item" ]]; then
should_skip_dir "$item"
return $?
else
should_skip_file "$item"
return $?
fi
}

# Binary-detection for the concatenation path: NUL bytes (grep -I rule)
# or bytes that are not valid UTF-8 (iconv check, when available) must
# not be dumped into the text stream. Valid UTF-8 text - including emoji -
# always passes.
is_binary_file() {
local f="$1"
[[ -s "$f" ]] || return 1
if grep -qI -e '' -- "$f" 2>/dev/null; then
if command -v iconv > /dev/null 2>&1; then
iconv -f UTF-8 -t UTF-8 -- "$f" > /dev/null 2>&1 || return 0
fi
return 1
fi
return 0
}

compress_content() {
local content="$1"
if [[ "$COMPRESS" == false ]] && [[ "$COMPRESS_HARD" == false ]]; then
printf '%s\n' "$content"
return
fi
if [[ "$COMPRESS_HARD" == true ]]; then
compress_hard_content "$content"
return
fi
printf '%s\n' "$content" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d'
}

compress_hard_content() {
local content="$1"
content=$(printf '%s\n' "$content" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
content=$(printf '%s\n' "$content" | sed -e '/^$/d')
local result=""
local in_multiline_comment=false
local regex_open='[\({\[<]'
local regex_close='[.,;:!?\)}\]>]'
while IFS= read -r line; do
[[ -z "$line" ]] && continue
if [[ "$in_multiline_comment" == true ]]; then
if [[ "$line" == *"*/"* ]]; then
in_multiline_comment=false
fi
result="${result}${line} "
continue
fi
if [[ "$line" == "/*"* ]] && [[ "$line" != *"*/"* ]]; then
in_multiline_comment=true
result="${result}${line} "
continue
fi
if [[ -n "$result" ]]; then
local last_char="${result: -1}"
local first_char="${line:0:1}"
if [[ "$last_char" =~ $regex_open ]] || [[ "$first_char" =~ $regex_close ]]; then
result="${result}${line} "
else
result="${result} ${line} "
fi
else
result="${line} "
fi
done <<< "$content"
result=$(printf '%s\n' "$result" | sed -e 's/[[:space:]]*$//' -e 's/[[:space:]]\+/ /g')
if [[ ${#result} -gt 1000 ]] && [[ "$WRITING_TO_FILE" == false ]]; then
print_warning "Hard compression created very long line (${#result} chars)"
fi
printf '%s\n' "$result"
}

# =============================================================================
# FIXED: Tree structure with prune-aware find
# FIXES: -mindepth 1 (no self-recursion), files now listed, last visible item
# gets the corner connector even after filters, NON_RECURSIVE decided by caller
# =============================================================================
get_tree_structure() {
local dir="$1"
local depth="${2:-0}"
local prefix="${3:-}"
local recursive="${4:-true}"
local parent_is_hidden="${5:-false}"
local force_show_hidden="${6:-false}"

if should_skip_dir "$dir"; then
if [[ $depth -eq 0 ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${YELLOW}📁 $dir (skipped)${NC}" || echo "📁 $dir (skipped)"
else
echo "${prefix}(skipped)"
fi
return
fi

local dir_name=$(basename "$dir")
# "." is the cwd, not a hidden directory: basename just matches ".*".
if [[ "$dir" != "." ]] && [[ "$dir_name" == .* ]]; then
local is_current_hidden=true
else
local is_current_hidden=false
fi

if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && \
[[ "$is_current_hidden" == true ]] && [[ "$parent_is_hidden" == false ]]; then
return
fi

if [[ $depth -eq 0 ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}${BLUE}📁 $dir${NC}" || echo "📁 $dir"
fi
# depth>0 adds no extra header: the parent's "└── name/" line already
# labels the subdirectory (keeps trees identical to the readme sample).
# Collect the visible entries first (skip-filtered), so the tree corner

# Collect the visible entries first (skip-filtered), so the tree corner
# connector lands on the truly last displayed item.
local find_opts="-maxdepth 1"
local -a visible_items=()
local item
while IFS= read -r item; do
[[ -z "$item" ]] && continue
local item_name=$(basename "$item")
local is_item_hidden=false
[[ "$item_name" == .* ]] && is_item_hidden=true

if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && \
[[ "$is_item_hidden" == true ]] && [[ "$is_current_hidden" == false ]]; then
continue
fi

if [[ -d "$item" ]]; then
should_skip_dir "$item" && continue
else
should_skip_file "$item" && continue
fi

# A -D destination is never drawn into the listing it is written into
# (it must not appear in the tree it contains). LSCAT-10.
is_output_file "$item" && continue

visible_items+=("$item")
done < <(
{ build_find_cmd "$dir" "" "$find_opts" "$INCLUDE_HIDDEN" "$is_current_hidden"; "${FIND_ARGS[@]}" 2>/dev/null; } \
| LC_ALL=C sort # deterministic listings: find returns fs entry (creation) order
)

local count=0
local total_items=${#visible_items[@]}
for item in "${visible_items[@]}"; do
local item_name=$(basename "$item")

count=$((count + 1))
local next_prefix="$prefix"
if [[ $count -eq $total_items ]]; then
next_prefix="${prefix}  "
echo -n "${prefix}└── "
else
next_prefix="${prefix}│  "
echo -n "${prefix}├── "
fi

if [[ -d "$item" ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BLUE}$item_name/${NC}" || echo "$item_name/"
if [[ "$recursive" == true ]] && ! should_skip_dir "$item"; then
get_tree_structure "$item" $((depth + 1)) "$next_prefix" "$recursive" "$is_current_hidden" "$force_show_hidden"
fi
else
local ext="${item_name##*.}"
if [[ "$WRITING_TO_FILE" == false ]]; then
case "$ext" in
"$item_name") echo -e "${GREEN}$item_name${NC}" ;;
sh|bash) echo -e "${MAGENTA}$item_name${NC}" ;;
py) echo -e "${YELLOW}$item_name${NC}" ;;
js|ts) echo -e "${CYAN}$item_name${NC}" ;;
md|txt) echo -e "${GREEN}$item_name${NC}" ;;
*) printf '%s\n' "$item_name" ;;
esac
else
echo "$item_name"
fi
fi
done

[[ $count -eq 0 ]] && echo "${prefix} (empty)"
}

# =============================================================================
# FIXED: LS structure with prune-aware find
# FIXES: -mindepth 1 (no base-dir echo), array find, empty-marker indent
# =============================================================================
get_ls_structure() {
local dir="$1"
local depth="${2:-0}"
local recursive="${3:-true}"
local parent_is_hidden="${4:-false}"
local force_show_hidden="${5:-false}"

if should_skip_dir "$dir"; then
if [[ $depth -eq 0 ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${YELLOW}📁 $dir (skipped)${NC}" || echo "📁 $dir (skipped)"
fi
return
fi

local dir_name=$(basename "$dir")
# "." is the cwd, not a hidden directory: basename just matches ".*".
if [[ "$dir" != "." ]] && [[ "$dir_name" == .* ]]; then
local is_current_hidden=true
else
local is_current_hidden=false
fi

if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && \
[[ "$is_current_hidden" == true ]] && [[ "$parent_is_hidden" == false ]]; then
return
fi

local indent=""
if [[ $depth -gt 0 ]] && [[ "$HEADER_TYPE" == "ls-R" ]]; then
for ((i=0; i<depth; i++)); do indent="${indent}  "; done
echo "${indent}$dir/"
elif [[ $depth -eq 0 ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}${BLUE}📁 $dir${NC}" || echo "📁 $dir"
fi

# Build find arguments with pruning
local find_opts="-maxdepth 1"
local files=()
local subdirs=()
local item
while IFS= read -r item; do
[[ -z "$item" ]] && continue
local item_name=$(basename "$item")
local is_item_hidden=false
[[ "$item_name" == .* ]] && is_item_hidden=true

if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && \
[[ "$is_item_hidden" == true ]] && [[ "$is_current_hidden" == false ]]; then
continue
fi

if [[ -d "$item" ]]; then
should_skip_dir "$item" && continue
else
should_skip_file "$item" && continue
fi

# Same destination exclusion as the tree: a -D file is never listed in
# the ls/ls-R structure it is being written into. LSCAT-10.
is_output_file "$item" && continue

[[ -d "$item" ]] && subdirs+=("$item") || files+=("$item")
done < <(
{ build_find_cmd "$dir" "" "$find_opts" "$INCLUDE_HIDDEN" "$is_current_hidden"; "${FIND_ARGS[@]}" 2>/dev/null; } \
| LC_ALL=C sort # deterministic listings: find returns fs entry (creation) order
)

for item in "${files[@]}"; do
local item_name=$(basename "$item")
local ext="${item_name##*.}"
local item_indent="$indent"
[[ "$HEADER_TYPE" == "ls-R" && $depth -gt 0 ]] && item_indent="${item_indent}  "

if [[ "$WRITING_TO_FILE" == false ]]; then
case "$ext" in
"$item_name") echo -e "${item_indent}${GREEN}$item_name${NC}" ;;
sh|bash) echo -e "${item_indent}${MAGENTA}$item_name${NC}" ;;
py) echo -e "${item_indent}${YELLOW}$item_name${NC}" ;;
js|ts) echo -e "${item_indent}${CYAN}$item_name${NC}" ;;
md|txt) echo -e "${item_indent}${GREEN}$item_name${NC}" ;;
*) printf '%s\n' "${item_indent}$item_name" ;;
esac
else
echo "${item_indent}$item_name"
fi
done

for item in "${subdirs[@]}"; do
local item_name=$(basename "$item")
local item_indent="$indent"
[[ "$HEADER_TYPE" == "ls-R" && $depth -gt 0 ]] && item_indent="${item_indent}  "

[[ "$WRITING_TO_FILE" == false ]] && echo -e "${item_indent}${BLUE}$item_name/${NC}" || echo "${item_indent}$item_name/"

if [[ "$recursive" == true ]] && [[ "$HEADER_TYPE" == "ls-R" ]] && ! should_skip_dir "$item"; then
get_ls_structure "$item" $((depth + 1)) "$recursive" "$is_current_hidden" "$force_show_hidden"
fi
done

if [[ ${#files[@]} -eq 0 ]] && [[ ${#subdirs[@]} -eq 0 ]]; then
if [[ "$HEADER_TYPE" == "ls-R" && $depth -gt 0 ]]; then
echo "${indent}(empty)"
else
echo "(empty)"
fi
fi

[[ "$HEADER_TYPE" == "ls-R" && $depth -eq 0 && ${#subdirs[@]} -gt 0 ]] && echo ""
}

process_file_content() {
local file="$1"
if [[ ! -f "$file" ]] || [[ ! -r "$file" ]]; then
print_warning "Cannot read file: $file"
return
fi
# Never dump raw binary bytes into the stream (would corrupt text output
# and any AI context fed with it).
if is_binary_file "$file"; then
print_warning "Binary file skipped: $file"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "\n${BOLD}File: ${CYAN}$file${NC}" || echo -e "\nFile: $file"
echo "[binary file - skipped]"
printf '%s\n' "${DELIMITER}"
return
fi

[[ "$WRITING_TO_FILE" == false ]] && echo -e "\n${BOLD}File: ${CYAN}$file${NC}" || echo -e "\nFile: $file"
printf '%s\n' "${DELIMITER}"

local file_content
file_content=$(cat "$file")

if [[ "$SHOW_LINE_NUMBERS" == true ]]; then
if [[ "$COMPRESS" == true ]] || [[ "$COMPRESS_HARD" == true ]]; then
local compressed_content=$(compress_content "$file_content")
local line_num=1
while IFS= read -r line; do
printf "%6d %s\n" "$line_num" "$line"
line_num=$((line_num + 1))
done <<< "$compressed_content"
else
cat -n "$file"
fi
elif [[ "$COMPRESS" == true ]] || [[ "$COMPRESS_HARD" == true ]]; then
compress_content "$file_content"
else
cat "$file"
fi
}

process_directory() {
local dir="$1"
local dir_name=$(basename "$dir")
local is_dir_hidden=false
[[ "$dir_name" == .* ]] && is_dir_hidden=true
local force_show_hidden="${2:-false}"

if should_skip_dir "$dir"; then
print_info "Skipping entire directory: $dir"
return
fi

if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && \
[[ "$is_dir_hidden" == true ]] && [[ "$dir" != "." ]]; then
# Hidden dirs stay hidden unless -a/-f named them explicitly.
local dir_norm="${dir#./}"
local is_listed=false
local listed_dir
for listed_dir in "${DIRECTORIES[@]}"; do
[[ "${listed_dir#./}" == "$dir_norm" ]] && { is_listed=true; break; }
done
[[ "$is_listed" == false ]] && return
fi

# Print directory structure header
if [[ "$HEADER_TYPE" != "none" ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "\n${BOLD}${MAGENTA}═══════════════════════════════════════════════════${NC}" || echo -e "\n═══════════════════════════════════════════════════"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}Directory Structure:${NC}" || echo "Directory Structure:"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${MAGENTA}═══════════════════════════════════════════════════${NC}\n" || echo -e "═══════════════════════════════════════════════════\n"

local recursive=true
[[ "$NON_RECURSIVE" == true && "$dir" == "." ]] && recursive=false

case "$HEADER_TYPE" in
"tree") get_tree_structure "$dir" 0 "" "$recursive" false "$force_show_hidden" ;;
"ls"|"ls-R") get_ls_structure "$dir" 0 "$recursive" false "$force_show_hidden" ;;
*) get_tree_structure "$dir" 0 "" "$recursive" false "$force_show_hidden" ;;
esac
fi

# Process file contents
local show_file_contents=true
if [[ "$show_file_contents" == true ]]; then
[[ "$WRITING_TO_FILE" == false ]] && echo -e "\n${BOLD}${MAGENTA}═══════════════════════════════════════════════════${NC}" || echo -e "\n═══════════════════════════════════════════════════"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}File Contents:${NC}" || echo "File Contents:"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${MAGENTA}═══════════════════════════════════════════════════${NC}" || echo "═══════════════════════════════════════════════════"

# Build find command with pruning for files
local find_maxdepth=""
[[ "$NON_RECURSIVE" == true && "$dir" == "." ]] && find_maxdepth="-maxdepth 1"

local file_count=0
while IFS= read -r file; do
[[ -z "$file" ]] && continue
should_skip_file "$file" && continue

local file_name=$(basename "$file")
if [[ "$force_show_hidden" == false ]] && [[ "$INCLUDE_HIDDEN" == false ]] && [[ "$file_name" == .* ]]; then
continue
fi

# Destination files must never be scanned into themselves.
if is_output_file "$file"; then
continue
fi

process_file_content "$file"
file_count=$((file_count + 1))
done < <(
{ build_find_cmd "$dir" "f" "$find_maxdepth" "$INCLUDE_HIDDEN" "$is_dir_hidden"; "${FIND_ARGS[@]}" 2>/dev/null; } \
| LC_ALL=C sort
)

if [[ $file_count -eq 0 ]]; then
if [[ "$WRITING_TO_FILE" == true ]]; then
# Summary/status lines must never land inside -D output files.
echo "No files found to process in this directory." >&2
else
echo -e "\nNo files found to process in this directory."
fi
else
if [[ "$WRITING_TO_FILE" == true ]]; then
echo "Processed $file_count files from $dir" >&2
else
echo -e "\nProcessed $file_count files from $dir"
fi
fi
fi
}

process_single_file() {
local file="$1"
if should_skip_file "$file"; then
print_warning "Skipping file: $file"
return
fi
if is_output_file "$file"; then
return
fi
print_info "Processing single file: $file"
# Never dump raw binary bytes into the stream (same guard as above).
if is_binary_file "$file"; then
print_warning "Binary file skipped: $file"
[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}File: ${CYAN}$file${NC}" || echo "File: $file"
echo "[binary file - skipped]"
printf '%s\n' "${DELIMITER}"
return
fi

[[ "$WRITING_TO_FILE" == false ]] && echo -e "${BOLD}File: ${CYAN}$file${NC}" || echo "File: $file"
printf '%s\n' "${DELIMITER}"

local file_content=$(cat "$file")
if [[ "$SHOW_LINE_NUMBERS" == true ]]; then
if [[ "$COMPRESS" == true ]] || [[ "$COMPRESS_HARD" == true ]]; then
local compressed_content=$(compress_content "$file_content")
local line_num=1
while IFS= read -r line; do
printf "%6d %s\n" "$line_num" "$line"
line_num=$((line_num + 1))
done <<< "$compressed_content"
else
cat -n "$file"
fi
elif [[ "$COMPRESS" == true ]] || [[ "$COMPRESS_HARD" == true ]]; then
