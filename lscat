#!/bin/bash
# =============================================================================
# lscat - List and concatenate directory/file contents with advanced options
# Version: 1.8.1 (FIXED: dash-leading filenames work as -d/-f values and
# through basename/cat/iconv, echo-flag swallowing in compression and
# delimiters eliminated with printf, exact -f/-d duplicate paths
# concatenated once, binary detection hardened with --)
# 1.8.0: unquoted arguments just work - files given to -d processed like
# -f and directories given to -f list their immediate files instead of
# being rejected, -de accepts values starting with "-" like the
# documented default "---", -D targets are checked for writability,
# binary files are skipped with a marker instead of dumping raw bytes,
# glob fallbacks respect -a
# 1.7.7: -d "*" no longer repeats every nested subtree, -d "*" also
# processes top-level files, deterministic C-sorted listings,
# summary lines kept out of -D output files
# 1.7.6: infinite tree recursion, -d . non-recursive, tree lists files,
# -D output un-polluted of Info lines, eval-free find, space-safe dedup,
# slashed glob fallback
# License: Custom (see LICENSE file)
# Repository: https://github.com/lionel-hue/LSCAT
# =============================================================================
VERSION="1.8.1"
SCRIPT_NAME=$(basename "$0")

# Default values
DELIMITER="---"
INCLUDE_HIDDEN=false
COMPRESS=false
COMPRESS_HARD=false
SHOW_LINE_NUMBERS=false
OUTPUT_FILES=()
SKIP_DIRS=()
SKIP_FILES=()
DIRECTORIES=()
FILES=()
CURRENT_DIR_ONLY=false
NON_RECURSIVE=false
POSITIONAL_DIRECTORIES=false
HEADER_TYPE="tree" # tree, ls, ls-R, none

# ANSI color codes (disabled when outputting to file)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
WRITING_TO_FILE=false

